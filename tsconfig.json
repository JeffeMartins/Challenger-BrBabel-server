{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "outDir": "build",
    "esModuleInterop": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "skipLibCheck": true,
    "strict": true,
    "strictPropertyInitialization": false
  },
  "include": [
    "src"
  ]
}
